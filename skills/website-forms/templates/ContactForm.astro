---
// Contact form (the website-forms skill). Posts to functions/api/contact.ts, which
// mails the message to the site owner. Works without JavaScript (a plain form post
// gets a small page back); with JavaScript the answer appears in place.
//
//   <ContactForm fallback="hello@your-domain.example" />
//
// `fallback`: the address a visitor can write to instead. Always shown under the form,
//             through EmailLink (never as plain text in the HTML), so there is another
//             way to reach the owner whatever happens to the form: a failed send, a
//             script that did not load, a browser without JavaScript. Required.
// `privacy`:  the privacy page's address. Default on a site with one language:
//             /privacy, or /datenschutz in German. On a site with several languages
//             there is no safe default, so it has to be passed.
// `lang`:     overrides the language (default: the page's locale on a site with several
//             languages, else the site's one language). Pass it on a page whose language
//             differs from the site's, e.g. a German page built with <Base lang="de">.
import { SITE } from '../config';
import EmailLink from './EmailLink.astro';
// The words, in every language the form speaks, and the limits: shared with the
// function, so a translation edits that one file.
import { LIMITS, TEXT, hasText } from './contact-form';

interface Props { fallback: string; privacy?: string; lang?: string }
const { fallback } = Astro.props;
const language = (Astro.props.lang ?? Astro.currentLocale ?? (SITE as { locale?: string }).locale ?? 'en').toLowerCase().split('-')[0];

// A language with no texts stops the build: an English form on a page in another
// language would otherwise go out unnoticed.
if (!hasText(language)) {
  throw new Error(`ContactForm: no texts for the language "${language}". Add it to src/components/contact-form.ts and to WORDS in tests/forms.spec.ts (the website-forms skill, §3 "Add a language").`);
}
const t = TEXT[language];
// With several languages the privacy page's address depends on the site's routes
// (/de/privacy, not /datenschutz), which this component cannot know.
if (!Astro.props.privacy && Astro.currentLocale) {
  throw new Error('ContactForm: on a site with several languages, pass privacy="…" (the privacy page in this page\'s language), and give this language its own copy of tests/forms.spec.ts with its PAGE and PRIVACY (the website-forms skill, §3 step 5).');
}
const privacy = Astro.props.privacy ?? t.privacy;
---
<form id="contact-form" class="contact-form" method="post" action="/api/contact" data-sending={t.sending} data-sent={t.sent} data-invalid={t.invalid} data-failed={t.failed}>
  <input type="hidden" name="lang" value={language} />
  <p>
    <label for="contact-name">{t.name}</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength={LIMITS.name} />
  </p>
  <p>
    <label for="contact-email">{t.email}</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength={LIMITS.email} />
  </p>
  <p>
    <label for="contact-message">{t.message}</label>
    <textarea id="contact-message" name="message" rows="6" required maxlength={LIMITS.message}></textarea>
  </p>
  {/* Not for people: hidden from sight, from the keyboard and from screen readers.
       A bot that fills every field fills this one, and its message is dropped. The
       name and autocomplete="off" give a browser or a password manager no reason to
       fill it in for a visitor; whether one does anyway was not measured, which is why
       the function logs every drop (keep the name in step with TRAP in
       functions/api/contact.ts). These notes are not sent to the browser. */}
  <p class="contact-form-trap" aria-hidden="true">
    <label for="contact-leave-empty">{t.trap}</label>
    <input id="contact-leave-empty" name="leave_empty" type="text" tabindex="-1" autocomplete="off" />
  </p>
  <p class="contact-form-note">{t.note} <a href={privacy}>{t.privacyLink}</a></p>
  <p><button type="submit">{t.send}</button></p>
  {/* The answer: the line a screen reader is told to read out when it changes. */}
  <p class="contact-form-status" role="status" aria-live="polite" data-contact-status></p>
  {/* Always there, never hidden: nothing has to work for a visitor to find it. */}
  <p class="contact-form-direct" data-contact-direct>{t.direct} <EmailLink address={fallback} lang={language} /></p>
</form>

<script>
  // With JavaScript the answer appears in the form itself. Without it the browser
  // posts the form and the function answers with a small page. Empty fields never get
  // this far: the browser's own validation stops them first. The function checks
  // again, a little more strictly, so "invalid" can still come back from it.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    // Every field read-only works on, found when the form is sent, so a field added later
    // is locked too. Left out: the kinds read-only does nothing on, which are hidden
    // fields, buttons (submit, reset, button, image), a checkbox, a radio button, a file,
    // a range and a colour, and a select is not an input at all. One of those that needs
    // locking needs a lock of its own. One :not() per kind: a list inside a single :not()
    // is newer and an older browser would throw on it.
    const typeable = ['hidden', 'submit', 'reset', 'button', 'image', 'checkbox', 'radio', 'file', 'range', 'color']
      .reduce((selector, kind) => `${selector}:not([type="${kind}"])`, 'input') + ', textarea';
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = form.dataset.sending ?? '';
      button.disabled = true;
      // Nothing can be typed while the message is on its way, so a success, which empties
      // the form, never takes words that were not sent. Read-only, not disabled: a
      // disabled field would be left out of the post. A field that was read-only already
      // stays that way.
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(typeable));
      const locked = fields.filter((field) => !field.readOnly);
      for (const field of locked) {
        field.readOnly = true;
        field.classList.add('contact-form-locked');
      }
      // Give up after 15 seconds, in every browser: the fields are locked until then.
      const timeout = new AbortController();
      const timer = setTimeout(() => timeout.abort(), 15000);
      let ok = false;
      let error: unknown;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          signal: timeout.signal,
        });
        const answer: unknown = await res.json();
        // Sent only when the function says so: a success status and ok exactly true. Any
        // other answer (null, a number, "ok": "false", an error status) is a failure.
        ok = res.ok && (answer as { ok?: unknown } | null)?.ok === true;
        error = (answer as { error?: unknown } | null)?.error;
      } catch {
        error = 'send_failed';
      } finally {
        clearTimeout(timer);
        for (const field of locked) {
          field.readOnly = false;
          field.classList.remove('contact-form-locked');
        }
        button.disabled = false;
      }
      if (ok) {
        form.reset();
        status.textContent = form.dataset.sent ?? '';
        return;
      }
      // Not sent. Say so in the announced line and keep what was typed. The failure
      // sentence points to the address under the form.
      status.textContent = (error === 'invalid' ? form.dataset.invalid : form.dataset.failed) ?? '';
    });
  }
</script>

<style>
  .contact-form label { display: block; font-weight: 600; margin-bottom: 0.25rem; }
  .contact-form input[type='text'], .contact-form input[type='email'], .contact-form textarea {
    width: 100%; max-width: 36rem; padding: 0.5rem; font: inherit; color: var(--ink);
    background: var(--surface); border: 1px solid var(--muted); border-radius: 6px;
  }
  .contact-form button { font: inherit; padding: 0.6rem 1.2rem; border-radius: 6px; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); cursor: pointer; }
  .contact-form button[disabled] { opacity: 0.6; cursor: default; }
  .contact-form .contact-form-locked { opacity: 0.7; }
  .contact-form-note { color: var(--muted); max-width: 36rem; }
  .contact-form-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

---
// Contact form (the website-forms skill). Posts to functions/api/contact.ts, which
// mails the message to the site owner. Works without JavaScript (a plain form post
// gets a small page back); with JavaScript the answer appears in place.
//
//   <ContactForm fallback="hello@your-domain.example" />
//
// `fallback`: the address a visitor can write to when sending fails. Shown through
//             EmailLink (never as plain text in the HTML): when a send fails, and
//             always to visitors without JavaScript. Required.
// `privacy`:  the privacy page's address. Default on a site with one language:
//             /privacy, or /datenschutz in German. On a site with several languages
//             there is no safe default, so it has to be passed.
// `lang`:     overrides the language (default: the page's locale on a site with several
//             languages, else the site's one language). Pass it on a page whose language
//             differs from the site's, e.g. a German page built with <Base lang="de">.
import { SITE } from '../config';
import EmailLink from './EmailLink.astro';

interface Props { fallback: string; privacy?: string; lang?: string }
const { fallback } = Astro.props;
const language = (Astro.props.lang ?? Astro.currentLocale ?? (SITE as { locale?: string }).locale ?? 'en').toLowerCase().split('-')[0];

// The tone rules apply to these texts too: no long dash, no contraction, and no form
// of address in German, so the form fits a "du" site and a "Sie" site alike.
const TEXT = {
  en: {
    name: 'Name', email: 'Email address', message: 'Message', send: 'Send message',
    note: 'What you enter here is sent to us by email and used only to answer you.',
    privacyLink: 'Privacy policy', privacy: '/privacy',
    trap: 'Leave this field empty',
    sending: 'Sending…',
    sent: 'Thank you. The message has been sent.',
    invalid: 'Some details are missing or not valid. Please check the fields.',
    failed: 'The message could not be sent.',
    direct: 'Please write to us directly:',
    noscript: 'If the form does not work, write to us directly:',
  },
  de: {
    name: 'Name', email: 'E-Mail-Adresse', message: 'Nachricht', send: 'Nachricht senden',
    note: 'Die Angaben werden per E-Mail an uns gesendet und nur für die Antwort verwendet.',
    privacyLink: 'Datenschutzerklärung', privacy: '/datenschutz',
    trap: 'Dieses Feld bitte leer lassen',
    sending: 'Wird gesendet…',
    sent: 'Danke. Die Nachricht wurde gesendet.',
    invalid: 'Einige Angaben fehlen oder sind ungültig. Bitte die Felder prüfen.',
    failed: 'Die Nachricht konnte nicht gesendet werden.',
    direct: 'Bitte direkt schreiben:',
    noscript: 'Falls das Formular nicht funktioniert, bitte direkt schreiben:',
  },
};
const t = TEXT[language as keyof typeof TEXT] ?? TEXT.en;
// With several languages the privacy page's address depends on the site's routes
// (/de/privacy, not /datenschutz), which this component cannot know.
if (!Astro.props.privacy && Astro.currentLocale) {
  throw new Error('ContactForm: on a site with several languages, pass privacy="…" (the privacy page in this page\'s language).');
}
const privacy = Astro.props.privacy ?? t.privacy;
---
<form id="contact-form" class="contact-form" method="post" action="/api/contact" data-sending={t.sending} data-sent={t.sent} data-invalid={t.invalid} data-failed={t.failed}>
  <input type="hidden" name="lang" value={language} />
  <p>
    <label for="contact-name">{t.name}</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" />
  </p>
  <p>
    <label for="contact-email">{t.email}</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" />
  </p>
  <p>
    <label for="contact-message">{t.message}</label>
    <textarea id="contact-message" name="message" rows="6" required maxlength="5000"></textarea>
  </p>
  <!-- Not for people: hidden from sight, from the keyboard and from screen readers.
       A bot that fills every field fills this one, and its message is dropped. The
       name says nothing a browser or a password manager would fill in for a visitor
       (keep it in step with TRAP in functions/api/contact.ts). -->
  <p class="contact-form-trap" aria-hidden="true">
    <label for="contact-leave-empty">{t.trap}</label>
    <input id="contact-leave-empty" name="leave_empty" type="text" tabindex="-1" autocomplete="off" />
  </p>
  <p class="contact-form-note">{t.note} <a href={privacy}>{t.privacyLink}</a></p>
  <p><button type="submit">{t.send}</button></p>
  <!-- The answer, read out by screen readers when it changes. -->
  <p class="contact-form-status" role="status" aria-live="polite" data-contact-status></p>
  <p class="contact-form-direct" data-contact-direct hidden>{t.direct} <EmailLink address={fallback} /></p>
  <!-- Without JavaScript nothing can reveal the line above, so it is always there. -->
  <noscript><p class="contact-form-direct">{t.noscript} <EmailLink address={fallback} /></p></noscript>
</form>

<script>
  // With JavaScript the answer appears in the form itself. Without it the browser
  // posts the form and the function answers with a small page. Empty fields never get
  // this far: the browser's own validation stops them first. The function checks
  // again, a little more strictly, so "invalid" can still come back from it.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    const direct = form.querySelector<HTMLElement>('[data-contact-direct]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      direct.hidden = true;
      status.textContent = form.dataset.sending ?? '';
      button.disabled = true;
      let outcome: { ok?: boolean; error?: string } = {};
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          signal: AbortSignal.timeout(15000),
        });
        outcome = await res.json();
      } catch {
        outcome = { ok: false, error: 'send_failed' };
      }
      button.disabled = false;
      if (outcome.ok) {
        form.reset();
        status.textContent = form.dataset.sent ?? '';
        return;
      }
      // Not sent. Say so in the announced line, keep what was typed, and show another
      // way to reach us: also when the function found a field it does not accept,
      // since the browser saw nothing wrong with it.
      status.textContent = (outcome.error === 'invalid' ? form.dataset.invalid : form.dataset.failed) ?? '';
      direct.hidden = false;
    });
  }
</script>

<style>
  .contact-form label { display: block; font-weight: 600; margin-bottom: 0.25rem; }
  .contact-form input[type='text'], .contact-form input[type='email'], .contact-form textarea {
    width: 100%; max-width: 36rem; padding: 0.5rem; font: inherit; color: var(--ink);
    background: var(--surface); border: 1px solid var(--muted); border-radius: 6px;
  }
  .contact-form button { font: inherit; padding: 0.6rem 1.2rem; border-radius: 6px; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); cursor: pointer; }
  .contact-form button[disabled] { opacity: 0.6; cursor: default; }
  .contact-form-note { color: var(--muted); max-width: 36rem; }
  .contact-form-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

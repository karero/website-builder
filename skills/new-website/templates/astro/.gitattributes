# Shell scripts and the git hook keep LF line endings on every checkout, Windows
# included. Git for Windows checks text files out with CRLF by default
# (core.autocrlf=true), sh then reads each CR as part of a command, and the pre-push
# hook fails on every push ("set: Illegal option -").
*.sh            text eol=lf
scripts/hooks/* text eol=lf
